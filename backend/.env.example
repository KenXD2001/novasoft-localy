# Copy to .env — every key is required, the app refuses to boot when any is missing/invalid.
NODE_ENV=development
HOST=localhost
PORT=5000
API_PREFIX=/api/v1

# PostgreSQL — database name is fixed per project convention.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/novasoft-locally-local?schema=public"

# Frontend origin allowed by CORS (must match frontend VITE_PORT, default 5199).
CORS_ORIGIN=http://localhost:5199

# Auth — HS256 signing secret (min 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-random-32-plus-character-secret
JWT_EXPIRES_IN=7d

# Artificial delay in milliseconds applied to every /api/v1 response (0 = disabled).
API_RESPONSE_DELAY=0

# Per-request timeout in milliseconds for live service health probing.
HEALTH_CHECK_TIMEOUT_MS=3000
